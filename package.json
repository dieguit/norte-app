{
  "name": "norte-app",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:stack": "pnpm db:up && turbo run dev",
    "db:studio": "pnpm db:up && DATABASE_URL=postgres://norte:norte@localhost:5433/norte pnpm --filter @repo/api db:studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "e2e": "pnpm --filter @repo/e2e e2e",
    "e2e:ui": "pnpm --filter @repo/e2e e2e:ui",
    "e2e:up": "docker compose --profile e2e --env-file apps/e2e/.env.test up --build --detach --wait postgres-e2e api-e2e web-e2e",
    "e2e:down": "docker compose --profile e2e rm --stop --force postgres-e2e api-e2e web-e2e",
    "db:test:up": "docker compose up -d postgres-test",
    "db:test:down": "docker compose stop postgres-test",
    "db:test:logs": "docker compose logs -f postgres-test",
    "mastra:studio": "npx -y mastra studio -p 3001 -s 3000 --server-api-prefix /agents",
    "lint": "turbo run lint",
    "fallow:audit": "fallow audit --base main --gate all",
    "test": "turbo run test",
    "check-types": "turbo run check-types"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@nestjs/common": "11.1.27",
      "@nestjs/core": "11.1.27",
      "@nestjs/platform-express": "11.1.27",
      "@clerk/tanstack-react-start>@clerk/backend": "3.16.6",
      "@clerk/backend@3.16.6>@clerk/shared": "4.29.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "@scarf/scarf",
      "esbuild",
      "lightningcss"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3"
  }
}
