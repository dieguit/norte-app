{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "audit": { "gate": "new-only" },
  "duplicates": { "ignore": ["src/components/ui/**", "src/db/schema.ts"], "minOccurrences": 3 },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60,
    // User-excluded route surfaces and test suites; do not refactor their health findings.
    "ignore": [
      "src/components/ui/**",
      "src/routes/informe/**",
      "src/routes/onboarding/**",
      "src/features/admin/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx"
    ]
  },
  "ignorePatterns": ["**/*.generated.ts", "**/*.d.ts"],
  "ignoreDependencies": ["@tailwindcss/typography"],
  "overrides": [{
    "files": ["src/components/ui/**"],
    "rules": {
      "unused-files": "off",
      "unused-exports": "off",
      "unused-types": "off",
      "unused-class-members": "off",
      "unused-component-props": "off"
    }
  }],
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-files": "error",
    "unused-dependencies": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-class-members": "error",
    "duplicate-exports": "error",
    "test-only-dependencies": "warn",
    "dev-dependencies-in-production": "warn",
    "stale-suppressions": "warn"
  }
}
