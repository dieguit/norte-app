{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "paraglide": "node --experimental-strip-types -e \"const {compile}=await import('@inlang/paraglide-js');const {paraglideOptions}=await import('./paraglide.options.ts');await compile(paraglideOptions)\"",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --format json --quiet --explain",
    "lint": "pnpm paraglide && tsc --noEmit",
    "check-types": "pnpm paraglide && tsc --noEmit"
  },
