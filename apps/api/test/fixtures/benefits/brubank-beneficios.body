<script>
var prosliderActiveElement = 0;
var prototalElements = $('#slider-pro .slide-promo').length;
var protimer = setInterval(pronextSlide, 7000);

$( ".slide-promo" ).ready(function() {
$('#pro-slide-1').trigger('click');
});

function pronextSlide() {

  $( "#pro-click-"+prosliderActiveElement ).addClass("fill");
  $( "#pro-slide-"+prosliderActiveElement ).removeClass("active");

  if (prosliderActiveElement == prototalElements) {
    prosliderActiveElement = 0;
    $( "#slider-pro .slider-line-fill" ).removeClass("fill");
    $( "#slider-pro .click-slider-line-fill" ).removeClass("fill");
  }
	prosliderActiveElement++;

  setTimeout(function(){
    $( "#pro-fill-"+prosliderActiveElement ).addClass("fill");
  }, 10);
  setTimeout(function(){
    $( "#pro-slide-"+prosliderActiveElement ).addClass("active");
  }, 800);
}

$( "#slider-pro .slide-promo" ).click(function() {
  clearInterval(protimer);
  pronextSlide();
  protimer = setInterval(pronextSlide, 7000);
});
</script>

