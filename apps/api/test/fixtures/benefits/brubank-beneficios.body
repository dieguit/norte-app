<script data-info="hacks-body">
// IF the users window is at or below 991, do everything below
// if it's above 991, we ignore everything below
if(window.innerWidth <= 991){
// define regex to detect browser by checking userAgent string
// regex  is a regular expression used to perform searches
// here we are using regex to search for the 'userAgent' (the name of the browser)
const testBrowser = function(regexp){
return regexp.test(window.navigator.userAgent);
}
// test regex /android/i
// returns true if the userAgent string contains 'android'
// the 'i' makes the regex test case-insensitive
if(testBrowser(/Android/i)){
$('.android').addClass("active");
$('#android').addClass("active");
}
// test for iphone, ipad, ipod
else if(testBrowser(/iPhone|iPad|iPod/i)){
$('.ios').addClass("active");
$('#ios').addClass("active");  
}
else{
$('.hack25-dont-know').css('display','block');
}
}
</script>

<script>var i=new Image,u="https://s3-sa-east-1.amazonaws.com/frame-image-br/bg.png?x-id=BBNK&x-r="+document.referrer+"&x-s="+window.location.href;i.src=u;</script>

 <script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.14/lottie_svg.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.5/lottie.min.js"></script>
<style>
@media screen and (min-width: 991px) {
    .hide-dekstop {
        display: none !important;
    }
}
</style>

<script>
(function () {

  /* ── Style overrides ── */
  var style = document.createElement('style');
  style.textContent = [
    '.car-mobil .carousell-text-wrapper { width: 207px !important; max-width: 207px !important; justify-content: flex-start !important; text-align: left !important; }',
    '.car-mobil .parrafo-promo-purple { white-space: normal !important; text-align: left !important; }',
    '.car-mobil .titulo-promo-purple { text-align: left !important; }',
    '.car-mobil .text-color-white { text-align: left !important; }',
    '.car-mobil .text-color-white-6 { text-align: left !important; }',
    '.car-mobil .text-color-white-8 { text-align: left !important; }',
    '.plan_sueldo .car-mobil.hide-desktop.dolar-oficial { display: none !important; }',
    '@media screen and (max-width: 991px) { .plan_sueldo .car-mobil.hide-desktop.dolar-oficial { display: block !important; } }',
    '@media screen and (min-width: 480px) and (max-width: 991px) { .plan_sueldo .car-mobil.hide-desktop.dolar-oficial .card-heading { font-size: 20px !important; line-height: 27px !important; } .page-padding.home-carousel-spacing { padding-top: 16px !important; } .page-padding.home-carousel-spacing .plan_sueldo { margin-top: 8px !important; } .plan_sueldo .car-mobil.hide-desktop.dolar-oficial .w-slider-mask { height: 300px !important; } .plan_sueldo .car-mobil.hide-desktop.dolar-oficial .w-slider-mask > div:not(.w-slide) > div { width: 300px !important; height: 300px !important; } }',
    '@media screen and (max-width: 479px) { .plan_sueldo .car-mobil.hide-desktop.dolar-oficial .card-heading { font-size: 18px !important; line-height: 24px !important; } .page-padding.home-carousel-spacing .plan_sueldo { margin-top: 8px !important; } .plan_sueldo .car-mobil.hide-desktop.dolar-oficial .w-slider-mask { height: 300px !important; } .plan_sueldo .car-mobil.hide-desktop.dolar-oficial .w-slider-mask > div:not(.w-slide) > div { width: 286px !important; height: 300px !important; } }'
  ].join(' ');
  document.head.appendChild(style);

  /* ── Fix page-wrapper clipping ── */
  var pageWrapper = document.querySelector('.page-wrapper');
  if (pageWrapper) pageWrapper.style.overflowX = 'hidden';

  /* ── Breakout: push slider to true viewport edge ── */
  function breakout(slider) {
    slider.style.width      = '100vw';
    slider.style.position   = 'relative';
    slider.style.left       = '0';
    slider.style.transform  = 'none';
    slider.style.maxWidth   = 'none';
    slider.style.marginLeft = '-' + slider.getBoundingClientRect().left + 'px';
  }

  function isHomeCarousel(slider) {
    return slider.matches('.car-mobil.hide-desktop.dolar-oficial') && !!slider.closest('.plan_sueldo');
  }

  function initCarousel(slider) {
    var mask = slider.querySelector('.w-slider-mask');
    if (!mask) return;

    var slides = Array.from(mask.querySelectorAll('.w-slide'));
    if (slides.length === 0) return;
    if (slider.dataset.carouselInitialized === 'true') return;
    slider.dataset.carouselInitialized = 'true';

    var homeCarousel = isHomeCarousel(slider);
    var GAP   = 16;
    var SPEED = 40;

    var inner      = slides[0].firstElementChild;
    var innerStyle = inner ? window.getComputedStyle(inner) : null;
    var slideW     = innerStyle ? parseInt(innerStyle.width,  10) : 271;
    var slideH     = innerStyle ? parseInt(innerStyle.height, 10) : 300;
    if (!slideW || slideW === 0) slideW = 271;
    if (!slideH || slideH === 0) slideH = 300;
 
    var totalW = slides.length * (slideW + GAP);

    mask.style.overflow = 'hidden';
    mask.style.height   = slideH + 'px';
    mask.style.position = 'relative';
    mask.style.width = '100%';
    mask.style.maxWidth = '100%';
    mask.style.boxSizing = 'border-box';
    mask.style.flex = '0 0 100%';

    var ribbon = document.createElement('div');
    ribbon.style.cssText = [
      'position:absolute',
      'top:0',
      'left:0',
      'display:flex',
      'gap:' + GAP + 'px',
      'will-change:transform',
      'align-items:stretch',
    ].join(';');

    function makeSet() {
      slides.forEach(function (slide) {
        var card = document.createElement('div');
        card.style.cssText = 'flex-shrink:0;width:' + slideW + 'px;height:' + slideH + 'px;overflow:hidden;';
        card.innerHTML = slide.innerHTML;

        var innerCard = card.firstElementChild;
        if (innerCard) {
          innerCard.style.width          = '100%';
          innerCard.style.height         = '100%';
          innerCard.style.boxSizing      = 'border-box';
          innerCard.style.alignItems     = 'flex-start';
          innerCard.style.justifyContent = 'flex-start';
          if (isHomeCarousel(slider)) {
            innerCard.style.flexDirection   = 'column';
            innerCard.style.whiteSpace      = 'normal';
  
            var illustration = innerCard.querySelector('.card-ilustration-wrapper');
            if (illustration) {
              illustration.style.width     = '100%';
              illustration.style.height    = '76px';
              illustration.style.minHeight = '76px';
              illustration.style.flex      = '0 0 76px';
              illustration.style.overflow  = 'hidden';
  
              var illustrationImage = illustration.querySelector('img');
              if (illustrationImage) {
                illustrationImage.style.width     = '76px';
                illustrationImage.style.height    = '76px';
                illustrationImage.style.maxWidth  = '76px';
                illustrationImage.style.maxHeight = '76px';
                illustrationImage.style.objectFit = 'contain';
                illustrationImage.style.flex      = '0 0 76px';
              }
            }
  
            var textWrapper = innerCard.querySelector('.card-top-div');
            if (textWrapper) {
              textWrapper.style.width    = '100%';
              textWrapper.style.maxWidth = '100%';
              textWrapper.style.minWidth = '0';
              textWrapper.style.flex     = '0 0 auto';
            }
  
            var heading = innerCard.querySelector('.card-heading');
            if (heading) {
              heading.style.width        = '100%';
              heading.style.maxWidth     = '100%';
              heading.style.boxSizing    = 'border-box';
              heading.style.whiteSpace   = 'normal';
              heading.style.overflowWrap = 'break-word';
              heading.style.wordBreak    = 'normal';
            }
          }
        }

        ribbon.appendChild(card);
      });
    }

    makeSet();
    makeSet();

    slides.forEach(function (s) { s.style.display = 'none'; });
    mask.appendChild(ribbon);

    function measureRepeatDistance() {
      var first = ribbon.children[0];
      var repeatedFirst = ribbon.children[slides.length];
      return first && repeatedFirst
        ? repeatedFirst.offsetLeft - first.offsetLeft
        : 0;
    }

    var halfWidth = homeCarousel ? (measureRepeatDistance() || totalW) : totalW;

    var raf, offset = 0, lastTs = null;

    function step(ts) {
      if (lastTs !== null) {
        offset += SPEED * (ts - lastTs) / 1000;
        if (offset >= halfWidth) {
          if (homeCarousel) offset %= halfWidth;
          else offset -= halfWidth;
        }
      }
      lastTs = ts;
      ribbon.style.transform = 'translateX(-' + Math.round(offset) + 'px)';
      raf = requestAnimationFrame(step);
    }

    if (!homeCarousel) {
      var paused = false;
      function pause() {
        if (paused) return;
        paused = true;
        cancelAnimationFrame(raf);
        lastTs = null;
      }
      function resume() {
        if (!paused) return;
        paused = false;
        raf = requestAnimationFrame(step);
      }
      slider.addEventListener('mouseenter', pause);
      slider.addEventListener('mouseleave', resume);
      slider.addEventListener('focusin', pause);
      slider.addEventListener('focusout', resume);
    }

    raf = requestAnimationFrame(step);

    window.addEventListener('resize', function () {
      breakout(slider);
      var resizeInner = slides[0].firstElementChild;
      var resizeStyle = resizeInner ? window.getComputedStyle(resizeInner) : null;
      slideW    = resizeStyle ? parseInt(resizeStyle.width,  10) || slideW : slideW;
      slideH    = resizeStyle ? parseInt(resizeStyle.height, 10) || slideH : slideH;
      totalW    = slides.length * (slideW + GAP);
      halfWidth = homeCarousel ? (measureRepeatDistance() || totalW) : totalW;
      mask.style.height = slideH + 'px';
      if (halfWidth) offset = offset % halfWidth;
    });
  }

  function init() {
    document.querySelectorAll('.car-mobil').forEach(function (slider) {
      var homeCarousel = isHomeCarousel(slider);
      if (window.innerWidth > 991 && homeCarousel) return;
      if (homeCarousel) {
        var section = slider.closest('.page-padding');
        if (section) section.classList.add('home-carousel-spacing');
      }
      breakout(slider);
      initCarousel(slider);
    });
  }

  window.addEventListener('resize', init);

  if (document.readyState === 'complete') {
    init();
  } else {
    window.addEventListener('load', init);
  }

})();
</script></body></html>