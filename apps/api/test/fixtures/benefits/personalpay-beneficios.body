aem-GridColumn--default--12"},"columnCount":12,":items":{"logobanner":{"desktopImage":{"path":"/content/dam/cms-personal-pay/2026/beneficios/cuadro/7-26/Desk_tabla_v2.svg","altText":"Desk_tabla_v2"},"mobileImage":{"path":"/content/dam/cms-personal-pay/2026/beneficios/cuadro/7-26/Mob_tabla_v2.svg","altText":"Mob_tabla_v2"},"imageAlign":"center","altImg":"tabla de beneficios",":type":"cms-personal-pay/components/logoBanner"},"separator":{"height":50,":type":"cms-personal-pay/components/separator"}},":itemsOrder":["logobanner","separator"],":type":"wcm/foundation/components/responsivegrid"},"separator_905767520_":{"height":30,":type":"cms-personal-pay/components/separator"},"benefits_list":{"pageSize":"12","title":"¡Conocé todos los beneficios!",":type":"cms-personal-pay/components/benefits-list"},"separator_905767520__613948381":{"height":104,":type":"cms-personal-pay/components/separator"},"banner_card_single_c":{"visible":true,"withoutGrid":false,"brand":"personal","contrast":"classic","headline":"<p><b><span style=\"color: rgb(255,255,255);\">Descargá la app</span></b></p>\r\n","subHeadline":"<p><span style=\"color: rgb(255,255,255);\">y disfrutá de todos los beneficios con Personal Pay</span></p>\r\n","size":"large","closable":false,"images":{"imageDesktop":{"assetPath":"/content/dam/cms-personal-pay/beneficios-ds/banner-card-download.png","path":"/content/dam/cms-personal-pay/beneficios-ds/banner-card-download.png","webMRenditions":{},"webPRenditions":{},"altText":"banner card download","img":true},"imageTablet":{"assetPath":"/content/dam/cms-personal-pay/beneficios-ds/banner-card-download.png","path":"/content/dam/cms-personal-pay/beneficios-ds/banner-card-download.png","webMRenditions":{},"webPRenditions":{},"altText":"banner card download","img":true},"imageMobile":{"assetPath":"/content/dam/cms-personal-pay/beneficios-ds/banner-card-download-mob.png","path":"/content/dam/cms-personal-pay/beneficios-ds/banner-card-download-mob.png","webMRenditions":{},"webPRenditions":{},"altText":"banner card download mob","img":true}},"link":{"visible":true,"seoIndex":true,"type":"primary-classic-standard","label":"Descargar app","url":"https://personalpay.go.link/welcome?utm_source=web&utm_medium=web_ppay&utm_campaign=landing_minegocio2&utm_id=60FA067F&utm_term=bannerdescarga&adj_t=22kwrf24&adj_creative=bannerdescarga&adj_fallback=https%3A%2F%2Fwww.personal.com.ar%2Fpay&adj_redirect_macos=https%3A%2F%2Fwww.personal.com.ar%2Fpay","target":"_self"},"metrics":{},"legal":{"theme":"light"},":type":"teco-cms-ecosystem/components/dcvm/banner-card-single"},"separator_905767520__1845539083":{"height":42,":type":"cms-personal-pay/components/separator"},"seo":{"title":"Beneficios y Descuentos en tu Billetera Virtual | Personal Pay","metadescription":"Con la billetera virtual de Personal Pay, disfrutá de los mejores descuentos en supermercados, combustibles, gastronomía, indumentaria y muchos más!","index":true,"follow":true,"canonical":"beneficios",":type":"cms-personal-pay/components/seo"},"accordion_group_copy":{"visible":true,"withoutGrid":false,"brand":"personal","autoCollapse":true,"style":"rounded","title":"<h2 style=\"text-align: center;\">¿En qué podemos ayudarte?</h2>\r\n","items":[{"pill":{"visible":true,"id":null,"icon":null,"color":null,"backgroundColor":null,"text":null},"headline":"<h3>¿Qué beneficios ofrece Personal Pay?</h3>\r\n","slots":[{"text":"<p>Con Personal Pay disfrutás de reintegros y descuentos semanales en diferentes locales y rubros.</p>\r\n<p>Mientras más uses la app, podés <a href=\"https://www.personal.com.ar/ayuda/pay/promociones-servicios/programa-niveles-personal-pay?icn=ayuda_ppay_niveles&amp;ici=ayuda_ppay_beneficios\">subir de nivel</a> y obtener aún mayores porcentajes de reintegro.</p>\r\n<p>Desde la <a href=\"https://links.personalpay.com.ar/xQMSyNvctuPXG1Eu7\">app</a> de Personal Pay, en “Beneficios” (ubicada en la barra inferior de tu pantalla) podés conocer todo lo que tenemos para vos.</p>\r\n"}]},{"pill":{"visible":true,"id":null,"icon":null,"color":null,"backgroundColor":null,"text":null},"headline":"<p><b>¿Dónde puedo ver los beneficios de Personal Pay?</b></p>\r\n","slots":[{"text":"<ol>\r\n<li><p>Ingresá a la <a href=\"https://links.personalpay.com.ar/xQMSyNvctuPXG1Eu7\">app</a> de Personal Pay.</p>\r\n</li>\r\n</ol>\r\n<ol>\r\n<li><p>Dentro de “Beneficios” (ubicado en la barra inferior de tu pantalla), buscá por categoría o nombre del local.</p>\r\n</li>\r\n</ol>\r\n<ol>\r\n<li><p>Seleccioná el beneficio que te interesa para conocer el detalle y las condiciones de uso que tiene.</p>\r\n</li>\r\n</ol>\r\n<p>&nbsp;</p>\r\n<p>⚠️ Siempre corroborá los métodos de pago que acepta (QR, tarjeta, NFC, etc.), qué días de la semana podés usarlos, frecuencia y vigencia.&nbsp;<br>\r\nAdemás, desde “Consultar sucursales” te mostramos en un mapa las más cercanas a tu ubicación donde podés usar ese beneficio.</p>\r\n"}]},{"pill":{"visible":true,"id":null,"icon":null,"color":null,"backgroundColor":null,"text":null},"headline":"<h3>¿A qué beneficios accedo por tener servicios de Personal?</h3>\r\n","slots":[{"text":"<ul>\r\n<li><p>Beneficio en el pago de tus facturas: si abonás tu factura de servicios Personal desde la app de Personal Pay, tenés un reintegro. El porcentaje del reintegro y el tope varían según el <a href=\"https://www.personal.com.ar/ayuda/pay/promociones-servicios/programa-niveles-personal-pay?icn=ayuda_ppay_niveles&amp;ici=ayuda_ppay_beneficios\">nivel</a> que tengas.&nbsp;<br>\r\nEl beneficio solo es válido para la primera factura del mes de Personal que pagues.&nbsp;<br>\r\n&nbsp;<br>\r\n&nbsp;</p>\r\n</li>\r\n</ul>\r\n<ul>\r\n<li><p>Beneficio en recargas de celu: si recargás tu celular desde la app de Personal Pay, tenés un reintegro en la primera recarga que hagas en la semana.</p>\r\n</li>\r\n</ul>\r\n"}]},{"pill":{"visible":true,"id":null,"icon":null,"color":null,"backgroundColor":null,"text":null},"headline":"<h3>¿Qué es y cómo funciona el programa Niveles Personal Pay?</h3>\r\n","slots":[{"text":"<p>Niveles Personal Pay es nuestro programa de beneficios. Dependiendo de cuánto consumas y vendas durante un mes, vas a tener un nivel u otro al mes siguiente.  ¡Cuánto más uses Personal Pay más beneficios tenés!<br>\r\nEsta obligación es impartida por el Fisco Nacional y los Fiscos Provinciales.</p>\r\n"}]}],"structuredData":"{\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"¿Qué beneficios ofrece Personal Pay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Con Personal Pay disfrutás de reintegros y descuentos semanales en diferentes locales y rubros.Mientras más uses la app, podés subir de nivel y obtener aún mayores porcentajes de reintegro.Desde la app de Personal Pay, en “Beneficios” (ubicada en la barra inferior de tu pantalla) podés conocer todo lo que tenemos para vos.\"}},{\"@type\":\"Question\",\"name\":\"¿Dónde puedo ver los beneficios de Personal Pay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ingresá a la app de Personal Pay.Dentro de “Beneficios” (ubicado en la barra inferior de tu pantalla), buscá por categoría o nombre del local.Seleccioná el beneficio que te interesa para conocer el detalle y las condiciones de uso que tiene.⚠️ Siempre corroborá los métodos de pago que acepta (QR, tarjeta, NFC, etc.), qué días de la semana podés usarlos, frecuencia y vigencia.Además, desde “Consultar sucursales” te mostramos en un mapa las más cercanas a tu ubicación donde podés usar ese beneficio.\"}},{\"@type\":\"Question\",\"name\":\"¿A qué beneficios accedo por tener servicios de Personal?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Beneficio en el pago de tus facturas: si abonás tu factura de servicios Personal desde la app de Personal Pay, tenés un reintegro. El porcentaje del reintegro y el tope varían según el nivel que tengas.El beneficio solo es válido para la primera factura del mes de Personal que pagues.Beneficio en recargas de celu: si recargás tu celular desde la app de Personal Pay, tenés un reintegro en la primera recarga que hagas en la semana.\"}},{\"@type\":\"Question\",\"name\":\"¿Qué es y cómo funciona el programa Niveles Personal Pay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Niveles Personal Pay es nuestro programa de beneficios. Dependiendo de cuánto consumas y vendas durante un mes, vas a tener un nivel u otro al mes siguiente.\\u2028\\u2028¡Cuánto más uses Personal Pay más beneficios tenés!Esta obligación es impartida por el Fisco Nacional y los Fiscos Provinciales.\"}}],\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"name\":\"¿En qué podemos ayudarte?\"}",":type":"teco-cms-ecosystem/components/dcvm/accordion-group"}},":itemsOrder":["hero_carousel_2102329669","separator_1488536537","text","floatingcta_copy","separator_905767520__1367025693","banner_card_multiple","separator_905767520__1481000352","separator_905767520__1849385766","banner_card_multiple_111729795","logos_module_carouse","separator_905767520__878840539","text_950688160","separator_905767520__723043487","responsivegrid","separator_905767520_","benefits_list","separator_905767520__613948381","banner_card_single_c","separator_905767520__1845539083","seo","accordion_group_copy"],":type":"wcm/foundation/components/responsivegrid"},"experiencefragment_1800494632":{"id":"footer","configured":true,"localizedFragmentVariationPath":"/content/experience-fragments/cms-personal-pay/ar/es/site/footer/new-footer/jcr:content","dataLayer":{"footer":{"@type":"cms-personal-pay/components/experiencefragment","repo:modifyDate":"2025-04-23T01:36:46Z"}},":items":{"root":{"gridClassNames":"aem-Grid aem-Grid--12 aem-Grid--default--12","columnClassNames":{"floatingcta_copy":"aem-GridColumn aem-GridColumn--default--12","prefooter":"aem-GridColumn aem-GridColumn--default--12","footerlegal":"aem-GridColumn aem-GridColumn--default--12","footer":"aem-GridColumn aem-GridColumn--default--12","floatingcta":"aem-GridColumn aem-GridColumn--default--12"},"columnCount":12,