  <script type='text/javascript'>
    (function () {
      var isTst = window.location.href.includes('test');

      var orgId = isTst ? '00DV90000051Rkr' : '00D4x0000018sSt';
      var deploymentName = 'AgenteServiClub';
      var siteUrl = isTst
        ? 'https://ypfargentinasa--uat.sandbox.my.site.com/ESWAgenteServiClubUAY1772656852562'
        : 'https://ypfargentinasa.my.site.com/ESWAgenteServiClub1768860419456';
      var scrt2Url = isTst
        ? 'https://ypfargentinasa--uat.sandbox.my.salesforce-scrt.com'
        : 'https://ypfargentinasa.my.salesforce-scrt.com';
      var bootstrapUrl = siteUrl + '/assets/js/bootstrap.min.js';

      function initEmbeddedMessaging() {
        try {
          embeddedservice_bootstrap.settings.language = 'es';
          embeddedservice_bootstrap.init(orgId, deploymentName, siteUrl, { scrt2URL: scrt2Url });
        } catch (err) {
          console.error('Error loading Embedded Messaging: ', err);
        }
      }

      var script = document.createElement('script');
      script.type = 'text/javascript';
      script.src = bootstrapUrl;
      script.onload = initEmbeddedMessaging;
      document.body.appendChild(script);
    })();
  </script>


  <script>
    // Abrir chat de Salesforce al hacer click en el botón
    document.querySelectorAll(".btnAgenteChat").forEach(el => {
      el.addEventListener("click", function () {
        try {
        // Buscar el botón de Salesforce por su clase
        const sfButton = document.querySelector('.slds-button.minimizedButton');

        console.log("Botón encontrado:", sfButton);

        if (sfButton) {
          // Mostrar temporalmente el botón
          sfButton.style.display = 'block';
          sfButton.style.visibility = 'visible';

          // Hacer click
          sfButton.click();

          // Volver a ocultar después de un pequeño delay
          setTimeout(() => {
            sfButton.style.display = 'none';
          }, 20);

        } else if (window.embeddedservice_bootstrap && window.embeddedservice_bootstrap.utilAPI) {
          // Alternativa: usar la API de Salesforce
          console.log('else if');
          window.embeddedservice_bootstrap.utilAPI.launchChat();
        } else {
          console.error("Chat de Salesforce no disponible");
        }
      } catch (e) {
        console.error("Error al abrir el chat:", e);
      }
      })
    });

  </script>


