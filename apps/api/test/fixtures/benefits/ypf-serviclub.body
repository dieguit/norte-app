    <!-- Contenido centrado -->
    <div class="hero-content text-center text-white">
      <h1 class="display-4 fw-bold text-uppercase">
        El programa de beneficios <br />más grande del país
      </h1>
      <p class="lead">Todos tus consumos en YPF suman puntos.</p>

      <a data-delay="1s" href="#programa" data-animate="fadeInUp" class="animate-on-screen text-decoration-none text-white position-absolute mb-4 bottom-0 more" data-delay="1250ms" data-animate="fadeIn">Conocé más<br><i class="bi bi-chevron-down"></i></a>
