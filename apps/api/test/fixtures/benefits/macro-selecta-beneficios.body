    <script>
          function setDataLayerFixed(id) {

            let modulo = document.getElementById("bm-modulo-fixed-" + id)

            let BotonFlotanteTitle = modulo.getAttribute("dataSliderTitle")
            let BotonFlotanteCategory = modulo.getAttribute("dataSliderCategory")
            let BotonFlotantePos = modulo.getAttribute("dataSliderPos")
            let BotonFlotanteFormat = modulo.getAttribute("dataSliderFormat")
            let BotonFlotanteCta = modulo.getAttribute("dataSliderCta")

            console.log("bm-modulo-fixed-" + id + "--BotonFlotanteTitle------"  + BotonFlotanteTitle + "--BotonFlotanteCategory------"  + BotonFlotanteCategory + "--BotonFlotantePos------"  + BotonFlotantePos + "--BotonFlotanteFormat------"  + BotonFlotanteFormat +  "--BotonFlotanteCta------"   +   BotonFlotanteCta )


            dataLayer.push({
                'event': 'moduloFixed_click',
                'BotonFlotanteCategory': BotonFlotanteCategory,
                'BotonFlotanteTitle': BotonFlotanteTitle,
                'BotonFlotantePos': BotonFlotantePos, 
                'BotonFlotanteFormat': BotonFlotanteFormat, 
                'BotonFlotanteCta': BotonFlotanteCta
        });

       
};
    </script>



                            
                                
    
    
    
        
            
        
    
    
    
    
