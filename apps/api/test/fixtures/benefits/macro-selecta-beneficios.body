<style>
             /* ESTILOS GENERALES */
            .bm-modulo-fixed {
            width: 100%;
            display: flex;
            justify-content: space-between;
            position: fixed;
            bottom: 0;
            left: 0;
            background-color: #000000;
            color: #fff;
            padding: 12px;
            z-index: 1500;
        }

        .bm-modulo-fixed img {
            max-width: 42px;
            max-height: 42px;
        }

        /* BOTONES */
        .bm-modulo-fixed .btn-club-belgrano {
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            background-color: #00a6e8;
            color: #fff;
            transition: 0.3s ease;
            border-radius: 150px;
            padding: 6px 24px;
        }

        .bm-modulo-fixed .btn-club-belgrano:hover {
            background-color: #fff;
            color: #00a6e8;
            border: 1px solid #00a6e8;
            transition: 0.3s ease;
        }

        .bm-modulo-fixed .btn-club-instituto {
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            background-color: #ff4351;
            color: #fff;
            transition: 0.3s ease;
            border-radius: 150px;
            padding: 6px 24px;
        }

        .bm-modulo-fixed .btn-club-instituto:hover {
            background-color: #fff;
            color: #ff4351;
            border: 1px solid #ff4351;
            transition: 0.3s ease;
        }

        @media only screen and (min-width: 768px) {
            .bm-modulo-fixed {
                width: auto;
                left: auto; 
                bottom:24px;
                right: 24px;
                background-color: transparent !important;
            }

            .bm-modulo-fixed img {
                display: none;
            }
        }
    </style>    

