ts.txt","contentType":"text/plain"}}},"sitemap":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"6n252fx9hkkr"}},"id":"5UXMJORWqMAZ9Mhg1u0wPx","type":"Asset","createdAt":"2024-07-10T13:45:19.470Z","updatedAt":"2026-10-29T18:25:43.812Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":67,"revision":17,"locale":"en-US"},"fields":{"title":"Sitemap Ualá CO","description":"Archivo sitemap sitio Ualá Colombia","file":{"url":"//assets.ctfassets.net/6n252fx9hkkr/5UXMJORWqMAZ9Mhg1u0wPx/6ff63d4d72b1c519bc74d50afbb85874/sitemap.xml","details":{"size":8172},"fileName":"sitemap.xml","contentType":"application/xml"}}}}}}}],"promotionLegal":"TÉRMINOS Y CONDICIONES — “YPF Mastercard EDV 2026”\n\nPromoción ofrecida por YPF S.A., CUIT 30-54668997-9, con domicilio en Macacha Güemes 515, Ciudad Autónoma de Buenos Aires, República Argentina (“YPF”), válida en la República Argentina, exclusivamente para compras de combustible realizadas con tarjeta de crédito y/o tarjeta prepaga de la marca “Mastercard” emitidas por Ualá Bank S.A.U., CUIT 30-71565463-2, con domicilio en Coronel Marcelino Freyre 3650, oficina 105, Ciudad Autónoma de Buenos Aires, Argentina (“Ualá”) (la/s “Tarjeta/s”) asociadas a la aplicación móvil “App YPF” (la “Aplicación”), los días lunes comprendidos desde las 00:00hs del 28/09/2026 hasta las 23:59hs del 31/10/2026 (el “Plazo de Vigencia”) en estaciones de servicio de YPF de la República Argentina (la “Promoción”).\nLa Promoción requiere un monto mínimo de compra de $35.000 (pesos argentinos treinta y cinco mil) y consiste en el reintegro de un 10% (diez por ciento) del monto abonado por la carga de combustible con un tope de reintegro semanal de $6.000 (pesos argentinos seis mil) por Tarjeta (el “Reintegro”).\nPara los consumos abonados con Tarjeta de crédito, el Reintegro será realizado dentro de los 60 (sesenta) días posteriores a la fecha de la transacción o dentro de los próximos 2 (dos) resúmenes. Para los consumos abonados con Tarjeta prepaga, el Reintegro será realizado dentro de los 30 (treinta) días posteriores a la fecha de la transacción en la cuenta asociada a la Tarjeta.\nPromoción no acumulable con otras promociones y/o beneficios vigentes ajenos a la presente acción. YPF es el exclusivo responsable por la prestación, correcto funcionamiento y/o garantía del producto y/o servicio adquirido. La Promoción podrá ser dejada sin efecto en cualquier momento por Ualá y por Mastercard Cono Sur S.R.L. por razones operativas, comerciales, regulatorias, de fuerza mayor o por circunstancias que así lo justifiquen. En tales casos, la medida será comunicada por los mismos medios utilizados para difundir la Promoción, sin afectar los Reintegros válidamente obtenidos con anterioridad a su finalización.\nPara más información se deberá consultar en el chat de la aplicación móvil Ualá ingresando desde el perfil del usuario en la sección “ayuda”. La Tarjeta de crédito y/o Tarjeta prepaga es ofrecida por Ualá, entidad financiera debidamente autorizada por el BCRA y se encuentra sujeta a condición crediticia. Para más información y condiciones o limitaciones aplicables, consulte en www.uala.com.ar/promociones.\n"}}],"componentName":"PromoCard","promotionLogoDark":{"metadata":{"tags":[{"sys":{"type":"Link","linkType":"Tag","id":"arPromociones"}}],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"6n252fx9hkkr"}},"id":"2LBokzSnzNFbm9KIkDJTsy","type":"Asset","createdAt":"2026-09-23T19:54:22.019Z","updatedAt":"2026-09-23T19:54:22.019Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":5,"revision":1,"locale":"en-US"},"fields":{"title":"logo YPF+MC darkmode","description":"logo YPF+MC darkmode","file":{"url":"//images.ctfassets.net/6n252fx9hkkr/2LBokzSnzNFbm9KIkDJTsy/6ce2ab5db407817bc0e6ca827d170871/logo_YPF_MC_darkmode.webp","details":{"size":10648,"image":{"width":1050,"h