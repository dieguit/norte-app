# Required - PostgreSQL connection string
DATABASE_URL=postgres://norte:norte@localhost:5432/norte

# Optional - Node environment (development | production | test)
# Default: development
NODE_ENV=development

# Optional - API port
# Default: 3001
PORT=3001

# Required - Clerk backend token verification
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:8080

# Required - OpenAI-compatible LLM endpoint (OmniRoute), base URL ending in /v1
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=replace-with-omniroute-api-key
# OmniRoute model id (GET {LLM_BASE_URL}/models)
#LLM_MODEL=kr/auto
LLM_MODEL=agy/gemini-3.8-flash-medium
LLM_GUARD_MODEL=agy/gemini-3.5-flash-lite

# Required - Bearer token for Mastra routes under /agents
MASTRA_API_KEY=replace-with-random-secret

# Optional - chat channel for norte-agent: whatsapp | telegram (unset = disabled)
# CHAT_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=
# Required when CHAT_CHANNEL is set
WEB_APP_URL=http://localhost:8080

# Optional - PostHog product analytics (unset token = disabled)
# POSTHOG_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com


