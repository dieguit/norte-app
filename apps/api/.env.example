# Required - PostgreSQL connection string
DATABASE_URL=postgres://norte:norte@localhost:5432/norte

# Optional - Node environment (development | production | test)
# Default: development
NODE_ENV=development

# Optional - API port
# Default: 3001
PORT=3001

# Required - Clerk backend token verification
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://your-web-origin.example

# Optional - Enable the WhatsApp connection on API startup
# Default: true
WHATSAPP_ENABLED=true
