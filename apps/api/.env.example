# Required - PostgreSQL connection string
DATABASE_URL=postgres://norte:norte@localhost:5432/norte

# Optional - Node environment (development | production | test)
# Default: development
NODE_ENV=development

# Optional - API port
# Default: 3000
PORT=3000

# Required - Clerk backend token verification
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:8080,http://localhost:3001

# Required when selecting OmniRoute models, base URL ending in /v1
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=replace-with-omniroute-api-key
# Defaults/providers/models: src/config/llm.config.ts
# Optional alias overrides (unique raw model IDs also accepted)
# LLM_MODEL=agy-flash-low
# LLM_GUARD_MODEL=agy-flash-lite
# Required when selecting direct OpenAI models
# OPENAI_API_KEY=replace-with-openai-api-key
# GROQ_API_KEY=replace-with-groq-api-key

# Required - Bearer token for Mastra routes under /agents
MASTRA_API_KEY=replace-with-random-secret

# Optional - chat channel for norte-agent: whatsapp | telegram (unset = disabled)
# CHAT_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=
# Required when CHAT_CHANNEL is set
WEB_APP_URL=http://localhost:8080

# Optional - PostHog product analytics (unset token = disabled)
# POSTHOG_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
