{
  "name": "@repo/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test vitest run src",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:debug": "vitest --inspect-brk --pool forks --poolOptions.forks.singleFork",
    "test:e2e": "NODE_ENV=test vitest run test --no-file-parallelism",
    "check-types": "tsc --noEmit",
    "benefits:ingest": "tsx --env-file=.env src/benefits/ingest/ingest.script.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "bench:agent": "tsx --env-file=.env scripts/bench-agent.ts"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.43.0",
    "@clerk/backend": "^3.25.0",
    "@mastra/core": "^1.78.0",
    "@mastra/memory": "^1.38.0",
    "@mastra/nestjs": "^0.2.37",
    "@mastra/observability": "^1.21.0",
    "@mastra/pg": "^1.31.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.5",
    "@repo/finance-utils": "workspace:^",
    "@repo/shared-types": "workspace:^",
    "baileys": "7.0.0-rc14",
    "bignumber.js": "^11.1.5",
    "chat-adapter-baileys": "^2.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.22.0",
    "posthog-node": "^5.43.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@mastra/evals": "1.10.9",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.15.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
